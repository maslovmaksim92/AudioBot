# ============================================================
# VasDom AudioBot — Environment Variables
# Copy this file to .env (in project root) and fill in real values.
# ============================================================

# ---------- Database (REQUIRED) ----------
# Local PostgreSQL on VPS (default in our setup):
DATABASE_URL=postgresql+asyncpg://audiobot:CHANGE_ME@127.0.0.1:5432/audiobot
# For Alembic / sync tools (same DB, sync driver):
DATABASE_URL_SYNC=postgresql+psycopg://audiobot:CHANGE_ME@127.0.0.1:5432/audiobot
# Postgres SSL mode (use 'disable' for local, 'require' for Neon/cloud):
PGSSLMODE=disable

# ---------- CORS / URLs ----------
# Allowed origins for the frontend (comma-separated). Use the public URL:
CORS_ORIGINS=https://ai.vd40.ru,http://localhost:3000
# Public backend URL (used by webhooks and frontend builds):
BACKEND_URL=https://ai.vd40.ru
REACT_APP_BACKEND_URL=https://ai.vd40.ru

# ---------- OpenAI (REQUIRED for AI chat / agents / voice) ----------
OPENAI_API_KEY=sk-...

# ---------- Telegram (optional, needed for bots/notifications) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_PHOTOS_CHANNEL_ID=
TELEGRAM_REPORT_CHAT_ID=
TELEGRAM_TARGET_CHAT_ID=
CHAT_ID_DIRECTOR=
TG_NEDVIGKA=

# ---------- Bitrix24 (optional, CRM integration) ----------
BITRIX24_WEBHOOK_URL=
WEBHOOK_URL=

# ---------- LiveKit + Novofon SIP (optional, only for outbound voice calls) ----------
LIVEKIT_URL=
LIVEKIT_WS_URL=
LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_DEFAULT_FROM=
NOVOFON_API_KEY=
NOVOFON_API_SECRET=
NOVOFON_CALLER_ID=
DEFAULT_CALLER_ID=

# ---------- SMTP (optional, for email notifications) ----------
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------- Auth ----------
# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_random_64_char_hex

# ---------- Deprecated / unused (do NOT set on VPS) ----------
# EMERGENT_LLM_KEY — legacy from Emergent platform, replaced by OPENAI_API_KEY
# NEON_DATABASE_URL — legacy cloud DB, replaced by local DATABASE_URL
# RENDER_API_KEY, RENDER_SERVICE_ID — only for reading Render logs, not used on VPS
