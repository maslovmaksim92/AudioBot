[Unit]
Description=VasDom AudioBot Backend (FastAPI/uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=audiobot
Group=audiobot
WorkingDirectory=/opt/audiobot/backend
EnvironmentFile=/opt/audiobot/.env
ExecStart=/opt/audiobot/backend/venv/bin/uvicorn server:app \
    --host 127.0.0.1 --port 8011 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
